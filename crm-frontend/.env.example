# --- CRM Frontend environment (Netlify env vars / local .env) ---
# HubSpot Private App token. Server-side ONLY. Never ship to the client.
HUBSPOT_ACCESS_TOKEN=
# Shared internal passphrase for the team (min 12 chars). PBKDF2-hashed at rest.
CRM_PASSPHRASE=
# Random secret used to HMAC-sign session cookies (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
CRM_SESSION_SECRET=
